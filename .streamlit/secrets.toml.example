[auth]
admin_username = "admin"
admin_password_hash = "SUBSTITUA_PELO_HASH_GERADO"

# Opcional: segundo acesso, com perfil GESTOR
director_username = "diretoria"
director_password_hash = "SUBSTITUA_PELO_HASH_GERADO_PARA_DIRETORIA"

# Opcional: arquivo JSON local da reestruturação (sem SQL).
[restructuring]
# storage_path = "data/private/reestruturacao.json"
# No Streamlit Cloud, baixe backups: arquivos locais não têm persistência garantida.

# Opcional: arquivo JSON do histórico, consultável apenas por admin.
[access_history]
# storage_path = "data/private/access_history.json"
